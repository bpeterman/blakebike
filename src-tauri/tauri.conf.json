{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "blake.bike",
  "version": "0.5.0",
  "identifier": "com.bpeterman.blakebike",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "blake.bike",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "appimage", "deb"],
    "category": "Healthcare and Fitness",
    "shortDescription": "Local-first smart trainer workouts",
    "longDescription": "Create and ride structured workouts with an FTMS Bluetooth smart trainer and BLE or ANT+ heart-rate sensors.",
    "linux": {
      "deb": {
        "files": {
          "/lib/udev/rules.d/70-blakebike-ant.rules": "../resources/70-blakebike-ant.rules"
        }
      },
      "appimage": {
        "files": {
          "/usr/share/blakebike/70-blakebike-ant.rules": "../resources/70-blakebike-ant.rules"
        }
      }
    },
    "macOS": {
      "infoPlist": "Info.plist"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
