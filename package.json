{
  "name": "blakebike",
  "private": true,
  "license": "GPL-3.0-or-later",
  "version": "0.2.0",
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "scripts": {
    "dev": "vite",
    "restart": "scripts/restart-dev.sh",
    "restart:bg": "scripts/restart-dev.sh -b",
    "stop": "scripts/restart-dev.sh --stop",
    "build": "tsc && vite build",
    "check": "pnpm check:web && pnpm check:rust",
    "check:web": "tsc --noEmit && eslint .",
    "check:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml -- --check && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "test": "pnpm test:web && pnpm test:rust",
    "test:web": "vitest run",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:watch": "vitest",
    "preview": "vite preview",
    "release": "node scripts/release.mjs prepare",
    "release:check": "node scripts/release.mjs check",
    "release:notes": "node scripts/release.mjs notes",
    "tauri": "tauri"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "lucide-react": "^0.544.0",
    "recharts": "^3.2.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@eslint/js": "^9.35.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^6.0.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.44.0",
    "vite": "^8.0.16",
    "@tauri-apps/cli": "^2",
    "eslint": "^9.35.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.4.0",
    "jsdom": "^27.0.0",
    "vitest": "^3.2.4"
  }
}
