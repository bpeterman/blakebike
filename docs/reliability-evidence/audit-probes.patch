+    #[test]
+    fn audit_eight_hour_synthetic_recording_and_recovery() {
+        let temp=tempfile::tempdir().unwrap();
+        let db=temp.path().join("long-ride.sqlite");
+        let storage=Storage::open(&db).unwrap();
+        let session=storage.start_session(None,"8-hour synthetic audit",84.0).unwrap();
+        let began=std::time::Instant::now();
+        let samples:Vec<Telemetry>=(0..144_000_i64).map(|i|Telemetry{
+            timestamp_ms:session.started_at.timestamp_millis()+i*200,
+            power_watts:200,cadence_rpm:Some(85.0),speed_kph:Some(30.0),heart_rate_bpm:Some(140),..Telemetry::default()
+        }).collect();
+        for batch in samples.chunks(1000) { storage.record_samples(session.id,batch).unwrap(); }
+        drop(storage);
+        let reopened=Storage::open(&db).unwrap();
+        assert_eq!(reopened.finalize_orphaned_sessions().unwrap().finalized,1);
+        let detail=reopened.session(session.id).unwrap().unwrap();
+        assert_eq!(detail.samples.len(),144_000);
+        let file=crate::fit::ensure_ride_file(&temp.path().join("fits"),&detail).unwrap();
+        assert!(file.is_file());
+        println!("AUDIT: synthetic 8h/5Hz ride: {} samples persisted/recovered/exported in {}ms; FIT {} bytes",detail.samples.len(),began.elapsed().as_millis(),std::fs::metadata(file).unwrap().len());
+    }
