+        let temp=tempfile::tempdir().unwrap();
+        let db=temp.path().join("crashed.sqlite");
+        let status=std::process::Command::new(std::env::current_exe().unwrap())
+            .args(["--exact","runner::tests::audit_abrupt_process_exit_child"])
+            .env("BLAKEBIKE_AUDIT_CHILD_DB",&db).status().unwrap();
+        assert_eq!(status.code(),Some(77));
+        let storage=Storage::open(&db).unwrap();
+        assert_eq!(storage.finalize_orphaned_sessions().unwrap().finalized,1);
+        let summary=storage.sessions().unwrap().remove(0);
+        assert_eq!(storage.session(summary.id).unwrap().unwrap().samples.len(),100);
+        println!("AUDIT: disposable process exited without destructors; all 100 committed samples recovered");
+    }
